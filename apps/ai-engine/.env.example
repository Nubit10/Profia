# Token de servicio compartido con apps/web (AI_ENGINE_TOKEN). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_ENGINE_TOKEN=""

# local (modelos reales) | mock (tests, sin modelos)
PROVIDER=local
QDRANT_URL=http://localhost:6333
MODELS_CACHE_DIR=.models
# DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Generación con LLM (ADR-0007) ---
# Cadena en orden; un eslabón sin configuración se omite.
LLM_CHAIN=["groq-qwen","groq-gptoss","ollama"]
# Clave gratuita de https://console.groq.com/keys (no pide tarjeta).
GROQ_API_KEY=
# GROQ_QWEN_MODEL=qwen/qwen3.8-27b
# GROQ_GPTOSS_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:1.7b
# Etapa 2 (servidor propio con vLLM): agrega "vllm" al inicio de LLM_CHAIN y completa:
# VLLM_BASE_URL=http://servidor-gpu:8000/v1
# VLLM_MODEL=Qwen/Qwen3-32B-AWQ

# --- Producción (docs/deploy/README.md, ADR-0011) ---
# La imagen Docker ya fija MODELS_CACHE_DIR, CATALOG_DIR y QDRANT_URL=:memory: (índice en memoria).
# En el hosting solo se definen: AI_ENGINE_TOKEN (nuevo), GROQ_API_KEY, PROVIDER=local y
# LLM_CHAIN=["groq-qwen","groq-gptoss"] (sin Ollama).
