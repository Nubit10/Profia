{
  "name": "@profe/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:seed": "node prisma/seed-dev.mjs",
    "curriculum:import": "node --conditions=react-server --import tsx scripts/curriculum-import.mts",
    "curriculum:verify": "python curriculum/tools/verify_sources.py",
    "metrics:resources": "node --conditions=react-server --import tsx scripts/resource-metrics.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "docx": "^9.8.1",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pdfmake": "^0.3.11",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "react-icons": "5.7.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.1",
    "sileo": "0.1.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
