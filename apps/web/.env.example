# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio (RN-02).

# Conexión a PostgreSQL (docker compose levanta una en localhost:5434 con usuario/clave "profe").
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/profe"

# Base usada por los tests de integración y E2E.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/profe_test"

# Secreto para firmar las sesiones. Genera uno con: npx auth secret   (mínimo 32 caracteres)
AUTH_SECRET=""

# AI Engine (SPEC-0005). Opcional: sin estas variables la búsqueda inteligente queda desactivada.
# El token debe ser el mismo AI_ENGINE_TOKEN configurado en apps/ai-engine/.env.
AI_ENGINE_URL="http://localhost:8100"
AI_ENGINE_TOKEN=""

# Notificaciones del navegador (SPEC-0013). Opcionales: sin ellas ProfIA no ofrece los avisos.
# Genera el par UNA vez con: npx web-push generate-vapid-keys  (cambiarlas invalida los avisos).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto para el servicio de avisos: mailto:soporte@tu-dominio o https://tu-dominio
VAPID_SUBJECT=""

# PIAR (SPEC-0017, ADR-0015). Opcional: sin ella ProfIA no ofrece el PIAR. Cifra los datos de los
# estudiantes. Genérala UNA vez con:  npm run piar:key -w @profia/web  (la escribe aquí y nunca
# reemplaza una existente) o con  openssl rand -base64 32
# Respáldala aparte de la base: si se pierde, los PIAR guardados no se pueden leer.
PIAR_ENCRYPTION_KEY=""

# Correo saliente (SPEC-0035, ADR-0021): el enlace para recuperar la contraseña. Opcional en desarrollo:
# sin SMTP_URL los correos quedan como archivos .json en apps/web/.mail-outbox/ (ábrelos para ver el enlace).
# En producción es necesario. Gmail: smtps://tu-correo%40gmail.com:CONTRASEÑA-DE-APLICACION@smtp.gmail.com:465
SMTP_URL=""
MAIL_FROM=""
# URL pública de ProfIA para los enlaces de los correos (en local, http://localhost:3000).
APP_URL=""
