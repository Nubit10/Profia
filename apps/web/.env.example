# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio (RN-02).

# Conexión a PostgreSQL (docker compose levanta una en localhost:5434 con usuario/clave "profe").
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/profe"

# Base usada por los tests de integración y E2E.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/profe_test"

# Secreto para firmar las sesiones. Genera uno con: npx auth secret   (mínimo 32 caracteres)
AUTH_SECRET=""

# AI Engine (SPEC-0005). Opcional: sin estas variables la búsqueda inteligente queda desactivada.
# El token debe ser el mismo AI_ENGINE_TOKEN configurado en apps/ai-engine/.env.
AI_ENGINE_URL="http://localhost:8100"
AI_ENGINE_TOKEN=""
